String jsonEstado() {
  char dist[16];
  if (distanciaCm < 0) snprintf(dist, sizeof(dist), "-1");
  else snprintf(dist, sizeof(dist), "%.1f", distanciaCm);

  char json[192];
  snprintf(json, sizeof(json),
           "{\"dist\":%s,\"luz\":%s,\"rgb\":\"%s\",\"presente\":%s,\"vent\":%s,\"ws\":%s}",
           dist,
           luzOn ? "true" : "false",
           corNome.c_str(),
           presente ? "true" : "false",
           ventiladorAtivo ? "true" : "false",
           wsConnected ? "true" : "false");
  return String(json);
}

void responder(const char* msg) {
  Serial.printf("[RESP] %s\n", msg);
  server.send(200, "text/plain; charset=utf-8", msg);
}

void handleRoot() {
  server.send_P(200, "text/html; charset=utf-8", PAGINA);
}

void handleEstado() {
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", jsonEstado());
}

void handleCmd() {
  if (!server.hasArg("acao")) {
    server.send(400, "text/plain; charset=utf-8", "Parametro 'acao' ausente");
    return;
  }

  String acao = server.arg("acao");

  if (acao == "luz_on") {
    aplicarComandoSantos("luz", "HIGH");
    responder("Luz ligada");
  } else if (acao == "luz_off" || acao == "rgb_off") {
    aplicarComandoSantos("luz", "LOW");
    responder("Luz desligada");
  } else if (acao == "vent_on") {
    aplicarComandoSantos("ventilador", "HIGH");
    responder("Ventilador ativado");
  } else if (acao == "vent_off") {
    aplicarComandoSantos("ventilador", "LOW");
    responder("Ventilador desligado");
  } else {
    server.send(400, "text/plain; charset=utf-8", "Acao nao reconhecida");
  }
}

// ===================== SETUP / LOOP =====================
void setup() {
  Serial.begin(115200);
  delay(200);
  Serial.println();
  Serial.println("Smart Home Santos (ESP32 + WS)");

  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT);
  digitalWrite(PIN_TRIG, LOW);

  pinMode(PIN_R, OUTPUT);
  pinMode(PIN_G, OUTPUT);
  pinMode(PIN_B, OUTPUT);
  digitalWrite(PIN_R, LOW);
  digitalWrite(PIN_G, LOW);
  digitalWrite(PIN_B, LOW);
  aplicarRGB(0, 0, 0, "OFF");

  // Servo no GPIO 18 — único uso de LEDC/PWM neste sketch
  servoVentilador.setPeriodHertz(50);
  servoVentilador.attach(PIN_SERVO, 500, 2400);
  servoVentilador.write(SERVO_CENTRO);
  anguloServo = SERVO_CENTRO;

  Wire.setPins(PIN_SDA, PIN_SCL);
  Wire.begin(PIN_SDA, PIN_SCL);
  lcd.init();
  lcd.backlight();
  linhaLCD(0, "Santos Home");
  linhaLCD(1, "WiFi...");

  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  unsigned long inicio = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - inicio < 20000) {
    delay(300);
    Serial.print(".");
  }
  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("IP ESP32: " + WiFi.localIP().toString());
    linhaLCD(0, "IP:");
    linhaLCD(1, WiFi.localIP().toString().c_str());

    if (BACKEND_USE_SSL) {
      // Render / HTTPS: wss://HOST/ws?role=esp32
      webSocket.beginSSL(BACKEND_HOST, BACKEND_PORT, BACKEND_WS_PATH);
      Serial.printf("WSS -> %s:%u%s\n", BACKEND_HOST, BACKEND_PORT, BACKEND_WS_PATH);
    } else {
      webSocket.begin(BACKEND_HOST, BACKEND_PORT, BACKEND_WS_PATH);
      Serial.printf("WS -> %s:%u%s\n", BACKEND_HOST, BACKEND_PORT, BACKEND_WS_PATH);
    }
    webSocket.onEvent(webSocketEvent);
    webSocket.setReconnectInterval(3000);
  } else {
    WiFi.mode(WIFI_AP);
    WiFi.softAP(AP_SSID);
    Serial.println("AP: " + WiFi.softAPIP().toString());
    linhaLCD(0, "AP SmartHome");
    linhaLCD(1, WiFi.softAPIP().toString().c_str());
  }

  delay(2000);
  tLCD = millis() - 3000;

  server.on("/", handleRoot);
  server.on("/estado", handleEstado);
  server.on("/cmd", handleCmd);
  server.begin();
}

void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    webSocket.loop();
    if (wsConnected && millis() - tWsPing >= 20000) {
      tWsPing = millis();
      webSocket.sendTXT("{\"type\":\"ping\"}");
    }
  }

  server.handleClient();
  atualizarSensores();
  atualizarLCD();
}
