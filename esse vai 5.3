<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
const $ = (selector) => document.querySelector(selector);

const estado = {
  luz: false,
  vent: false,
  pronto: false
};

const ocupado = {
  luz: false,
  vent: false
};

let atualizando = false;
let toastTimer = null;

function mostrarToast(mensagem, erro = false) {
  const toast = $('#toast');

  toast.textContent = mensagem;
  toast.classList.toggle('error', erro);
  toast.classList.add('visible');

  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => {
    toast.classList.remove('visible');
  }, 3200);
}

function renderizarDispositivo(chave) {
  const ligado = estado[chave];
  const prefixo = chave === 'luz' ? 'luz' : 'vent';
  const nome = chave === 'luz' ? 'luz' : 'ventilador';

  const botao = $('#' + prefixo + 'Toggle');
  const status = $('#' + prefixo + 'Status');
  const icone = $('#' + prefixo + 'Icon');

  botao.disabled = !estado.pronto || ocupado[chave];
  botao.classList.toggle('active', ligado);
  botao.setAttribute('aria-pressed', String(ligado));
  botao.setAttribute(
    'aria-label',
    ligado ? 'Desligar ' + nome : 'Ligar ' + nome
  );

  icone.classList.toggle('active', ligado);
  status.classList.toggle('active', ligado);

  status.innerHTML = ligado
    ? '<span class="status-dot"></span><span>Ligado</span>'
    : '<span class="status-dot"></span><span>Desligado</span>';
}

function atualizarInterface(data) {
  estado.luz = Boolean(data.luz);
  estado.vent = Boolean(data.vent);
  estado.pronto = true;

  renderizarDispositivo('luz');
  renderizarDispositivo('vent');

  // Presença
  $('#presenceText').textContent =
    data.presente ? 'Presença detectada' : 'Ambiente livre';

  $('#presenceHint').textContent =
    data.presente
      ? 'Alguém está próximo do sensor'
      : 'Nenhuma presença detectada';

  // Distância
  const distancia = Number(data.dist);

  if (Number.isFinite(distancia) && distancia >= 0) {
    $('#distanceValue').textContent =
      distancia.toFixed(1).replace('.', ',') + ' cm';

    $('#distanceHint').textContent = 'Distância medida pelo HC-SR04';

    const percentual = Math.max(0, Math.min(100, distancia / 200 * 100));
    $('#distanceFill').style.width = percentual + '%';
  } else {
    $('#distanceValue').textContent = '--';
    $('#distanceHint').textContent = 'Aguardando leitura do sensor';
    $('#distanceFill').style.width = '0%';
  }

  // Backend / WebSocket
  const conectado = Boolean(data.ws);

  $('#backendValue').textContent =
    conectado ? 'Conectado' : 'Desconectado';

  $('#backendHint').textContent =
    conectado ? 'Comunicação estabelecida' : 'Sem conexão com o backend';

  $('#wsPill').classList.toggle('is-online', conectado);
  $('#wsPill').classList.toggle('is-offline', !conectado);

  $('#wsLabel').textContent =
    conectado ? 'BACKEND CONECTADO' : 'BACKEND OFFLINE';

  const agora = new Intl.DateTimeFormat('pt-BR', {
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit'
  }).format(new Date());

  $('#lastUpdate').textContent = 'Última atualização: ' + agora;
}

async function atualizarEstado() {
  if (atualizando) return;

  atualizando = true;
  $('#refreshButton').classList.add('loading');

  try {
    const resposta = await fetch('/estado', {
      cache: 'no-store'
    });

    if (!resposta.ok) {
      throw new Error('Não foi possível consultar o ESP32.');
    }

    const data = await resposta.json();
    atualizarInterface(data);

  } catch (erro) {
    $('#lastUpdate').textContent = 'Falha ao atualizar informações';

    if (!estado.pronto) {
      $('#presenceText').textContent = 'Indisponível';
      $('#backendValue').textContent = 'Sem resposta';
    }
  } finally {
    atualizando = false;
    $('#refreshButton').classList.remove('loading');
  }
}

async function alternarDispositivo(chave) {
  if (!estado.pronto || ocupado[chave]) return;

  const proximoEstado = !estado[chave];

  const acao = chave === 'luz'
    ? (proximoEstado ? 'luz_on' : 'luz_off')
    : (proximoEstado ? 'vent_on' : 'vent_off');

  ocupado[chave] = true;
  renderizarDispositivo(chave);

  try {
    const resposta = await fetch('/cmd?acao=' + acao, {
      method: 'GET',
      cache: 'no-store'
    });

    const mensagem = await resposta.text();

    if (!resposta.ok) {
      throw new Error(mensagem || 'Não foi possível executar o comando.');
    }

    mostrarToast(mensagem || 'Comando enviado com sucesso.');
    await atualizarEstado();

  } catch (erro) {
    mostrarToast(erro.message || 'Erro ao enviar comando.', true);

  } finally {
    ocupado[chave] = false;
    renderizarDispositivo(chave);
  }
}

// Eventos dos controles
$('#luzToggle').addEventListener('click', () => {
  alternarDispositivo('luz');
});

$('#ventToggle').addEventListener('click', () => {
  alternarDispositivo('vent');
});

$('#refreshButton').addEventListener('click', atualizarEstado);

// Relógio local
function atualizarRelogio() {
  $('#clockTime').textContent = new Intl.DateTimeFormat('pt-BR', {
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit'
  }).format(new Date());
}

atualizarRelogio();
setInterval(atualizarRelogio, 1000);

// Atualização automática do painel
atualizarEstado();
setInterval(() => {
  if (!document.hidden) atualizarEstado();
}, 2000);
</script>

</body>
</html>
)HTML";

String jsonEstado() {
  char dist[16];
  if (distanciaCm < 0) snprintf(dist, sizeof(dist), "-1");
  else snprintf(dist, sizeof(dist), "%.1f", distanciaCm);

  char json[192];
  snprintf(json, sizeof(json),
           "{\"dist\":%s,\"luz\":%s,\"rgb\":\"%s\",\"presente\":%s,\"vent\":%s,\"ws\":%s}",
           dist,
           luzOn ? "true" : "false",
           corNome.c_str(),
           presente ? "true" : "false",
           ventiladorAtivo ? "true" : "false",
           wsConnected ? "true" : "false");
  return String(json);
}

void responder(const char* msg) {
  Serial.printf("[RESP] %s\n", msg);
  server.send(200, "text/plain; charset=utf-8", msg);
}

void handleRoot() {
  server.send_P(200, "text/html; charset=utf-8", PAGINA);
}

void handleEstado() {
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", jsonEstado());
}

void handleCmd() {
  if (!server.hasArg("acao")) {
    server.send(400, "text/plain; charset=utf-8", "Parametro 'acao' ausente");
    return;
  }

  String acao = server.arg("acao");

  if (acao == "luz_on") {
    aplicarComandoFrancisca("luz", "HIGH");
    responder("Luz ligada");
  } else if (acao == "luz_off" || acao == "rgb_off") {
    aplicarComandoFrancisca("luz", "LOW");
    responder("Luz desligada");
  } else if (acao == "vent_on") {
    aplicarComandoFrancisca("ventilador", "HIGH");
    responder("Ventilador ativado");
  } else if (acao == "vent_off") {
    aplicarComandoFrancisca("ventilador", "LOW");
    responder("Ventilador desligado");
  } else {
    server.send(400, "text/plain; charset=utf-8", "Acao nao reconhecida");
  }
}

// ===================== SETUP / LOOP =====================
void setup() {
  Serial.begin(115200);
  delay(200);
  Serial.println();
  Serial.println("Smart Home Francisca (ESP32 + WS)");

  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT);
  digitalWrite(PIN_TRIG, LOW);

  pinMode(PIN_R, OUTPUT);
  pinMode(PIN_G, OUTPUT);
  pinMode(PIN_B, OUTPUT);
  digitalWrite(PIN_R, LOW);
  digitalWrite(PIN_G, LOW);
  digitalWrite(PIN_B, LOW);
  aplicarRGB(0, 0, 0, "OFF");

  // Servo no GPIO 18 — único uso de LEDC/PWM neste sketch
  servoVentilador.setPeriodHertz(50);
  servoVentilador.attach(PIN_SERVO, 500, 2400);
  servoVentilador.write(SERVO_CENTRO);
  anguloServo = SERVO_CENTRO;

  Wire.setPins(PIN_SDA, PIN_SCL);
  Wire.begin(PIN_SDA, PIN_SCL);
  lcd.init();
  lcd.backlight();
  linhaLCD(0, "Francisca");
  linhaLCD(1, "WiFi...");

  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  unsigned long inicio = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - inicio < 20000) {
    delay(300);
    Serial.print(".");
  }
  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("IP ESP32: " + WiFi.localIP().toString());
    linhaLCD(0, "IP:");
    linhaLCD(1, WiFi.localIP().toString().c_str());

    if (BACKEND_USE_SSL) {
      // Render / HTTPS: wss://HOST/ws?role=esp32
      webSocket.beginSSL(BACKEND_HOST, BACKEND_PORT, BACKEND_WS_PATH);
      Serial.printf("WSS -> %s:%u%s\n", BACKEND_HOST, BACKEND_PORT, BACKEND_WS_PATH);
    } else {
      webSocket.begin(BACKEND_HOST, BACKEND_PORT, BACKEND_WS_PATH);
      Serial.printf("WS -> %s:%u%s\n", BACKEND_HOST, BACKEND_PORT, BACKEND_WS_PATH);
    }
    webSocket.onEvent(webSocketEvent);
    webSocket.setReconnectInterval(3000);
  } else {
    WiFi.mode(WIFI_AP);
    WiFi.softAP(AP_SSID);
    Serial.println("AP: " + WiFi.softAPIP().toString());
    linhaLCD(0, "AP SmartHome");
    linhaLCD(1, WiFi.softAPIP().toString().c_str());
  }

  delay(2000);
  tLCD = millis() - 3000;

  server.on("/", handleRoot);
  server.on("/estado", handleEstado);
  server.on("/cmd", handleCmd);
  server.begin();
}

void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    webSocket.loop();
    if (wsConnected && millis() - tWsPing >= 20000) {
      tWsPing = millis();
      webSocket.sendTXT("{\"type\":\"ping\"}");
    }
  }

  server.handleClient();
  atualizarSensores();
  atualizarLCD();
}
