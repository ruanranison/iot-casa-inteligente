.device-status .status-dot{
  width:6px;
  height:6px;
  background:#66777b;
  box-shadow:none;
}

.device-status.active{color:var(--accent)}
.device-status.active .status-dot{
  background:var(--accent);
  box-shadow:0 0 8px rgba(98,230,193,.4);
}

/* SWITCH */

.switch{
  position:relative;
  flex-shrink:0;
  width:54px;
  height:30px;
  padding:0;
  border:1px solid rgba(255,255,255,.09);
  border-radius:30px;
  background:#27363c;
  cursor:pointer;
  transition:background .25s,border-color .25s;
}

.switch:disabled{
  opacity:.45;
  cursor:not-allowed;
}

.switch-track{
  position:absolute;
  inset:0;
  border-radius:30px;
}

.switch-thumb{
  position:absolute;
  top:4px;
  left:4px;
  width:20px;
  height:20px;
  border-radius:50%;
  background:#a9b6b8;
  box-shadow:0 2px 5px rgba(0,0,0,.2);
  transition:transform .25s,background .25s;
}

.switch.active{
  border-color:rgba(98,230,193,.4);
  background:#24584d;
}

.switch.active .switch-thumb{
  transform:translateX(24px);
  background:var(--accent);
}

.sr-only{
  position:absolute;
  width:1px;
  height:1px;
  padding:0;
  overflow:hidden;
  clip:rect(0,0,0,0);
  white-space:nowrap;
  border:0;
}

/* AUTOMATION PANEL */

.automation-panel{
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  min-height:100%;
}

.automation-icon{
  display:grid;
  place-items:center;
  width:43px;
  height:43px;
  margin-bottom:17px;
  border:1px solid rgba(98,230,193,.13);
  border-radius:14px;
  color:var(--accent);
  background:rgba(98,230,193,.08);
}

.automation-icon svg{width:22px;height:22px}

.automation-title{
  margin:0;
  font-size:15px;
  font-weight:760;
}

.automation-text{
  margin:10px 0 19px;
  color:var(--muted);
  font-size:11px;
  line-height:1.8;
}

.rule-list{
  display:grid;
  gap:10px;
  padding-top:16px;
  border-top:1px solid var(--border);
}

.rule{
  display:flex;
  align-items:center;
  gap:10px;
  color:#c1d0d1;
  font-size:11px;
}

.rule-mark{
  display:grid;
  place-items:center;
  width:22px;
  height:22px;
  flex-shrink:0;
  border-radius:8px;
  color:var(--accent);
  background:rgba(98,230,193,.09);
  font-size:11px;
  font-weight:800;
}

/* FOOTER */

.footer{
  display:flex;
  justify-content:space-between;
  gap:15px;
  margin-top:24px;
  padding:17px 3px 5px;
  color:#647a80;
  font-size:10px;
}

.footer strong{
  color:#9aafb2;
  font-weight:700;
}

.toast{
  position:fixed;
  right:22px;
  bottom:22px;
  z-index:10;
  max-width:min(360px,calc(100vw - 32px));
  padding:13px 17px;
  border:1px solid rgba(98,230,193,.25);
  border-radius:13px;
  background:#172a2b;
  color:#dffaf1;
  box-shadow:0 12px 35px rgba(0,0,0,.35);
  font-size:12px;
  opacity:0;
  transform:translateY(12px);
  pointer-events:none;
  transition:.25s;
}

.toast.visible{
  opacity:1;
  transform:translateY(0);
}

.toast.error{
  border-color:rgba(255,119,119,.3);
  background:#321d22;
  color:#ffdede;
}

@media(max-width:760px){
  .shell{padding:23px 17px}
  .topbar{margin-bottom:35px}
  .content-grid{grid-template-columns:1fr}
  .automation-panel{min-height:auto}
}

@media(max-width:560px){
  .shell{padding:20px 14px}
  .topbar{margin-bottom:30px}
  .brand-mark{width:40px;height:40px}
  .brand-name{font-size:13px}
  .ws-pill{padding:9px 10px;font-size:9px}
  .welcome{align-items:flex-start;flex-direction:column}
  .clock-card{
    display:flex;
    align-items:center;
    gap:12px;
    width:100%;
    padding:12px 15px;
  }
  .clock-label{margin:0}
  .clock-time{font-size:17px}
  .clock-caption{margin:0 0 0 auto}
  .metrics{grid-template-columns:1fr;gap:10px}
  .metric-card{min-height:125px;padding:17px}
  .metric-value{margin-top:10px;font-size:22px}
  .panel{padding:19px}
  .footer{flex-direction:column}
}

@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{
    scroll-behavior:auto!important;
    animation-duration:.01ms!important;
    transition-duration:.01ms!important;
  }
}
