/*
  SMARTa HOME SANTOS - ESP32 + WebSocket + Gemini (via backend Node)

  Este sketch recebe comandos GPIO do backend:
    ws://BACKEND_HOST:BACKEND_PORT/ws?role=esp32

  Protocolo (servidor -> ESP32):
    { "type": "gpio", "response": "Ligando a luz.",
      "commands": [{ "component": "luz"|"ventilador", "state": "HIGH"|"LOW" }] }
  A "response" aparece no LCD 16x2 por ~6 segundos.

  Proximidade (HC-SR04) — só automático, NÃO bloqueia voz:
    chegou (<=80 cm)  -> luz liga + servo oscila
    saiu   (>=100 cm) -> luz e ventilador desligam
  Comandos de voz/WS sempre são aplicados (mic fica no celular/PC).

  Mapeamento:
    luz HIGH/LOW, ventilador HIGH/LOW

  Bibliotecas (Arduino IDE -> Gerenciar bibliotecas):
    - ESP32Servo
    - LiquidCrystal I2C (ou LiquidCrystal_I2C)
    - WebSockets by Markus Sattler (Links2004)
    - ArduinoJson (v6 ou v7)

  Fiação:
    RGB R/G/B   GPIO 13 / 12 / 14
    HC-SR04     TRIG 27, ECHO 26 (divisor no ECHO)
    LCD I2C     SDA 32, SCL 33
    Servo SG90  sinal GPIO 18
*/

#include <WiFi.h>
#include <WebServer.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <ESP32Servo.h>
#include <WebSocketsClient.h>
